# FinKit Environment Configuration Template
# Copy this file to .env and fill in the required values

# Database Configuration
# Leave empty for auto-discovery of public/private databases
# Or set explicitly for custom paths
PUBLIC_DATABASE_URL=
PRIVATE_DATABASE_URL=
# DATABASE_URL=  # Fallback for single-database mode

# Security (REQUIRED - generate secure random keys for production)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ENCRYPTION_KEY=

# AI Search Configuration
AI_SEARCH_BACKEND=duckduckgo  # Options: duckduckgo, tavily
AI_SEARCH_API_KEY=            # Required only if using Tavily

# AI Inference Configuration (for investment analysis, AI advisor)
AI_INFERENCE_API_URL=         # OpenAI-compatible API endpoint (e.g., https://api.openai.com/v1)
AI_INFERENCE_API_KEY=         # API key for inference service
AI_INFERENCE_MODEL=           # Model name (e.g., gpt-4o-mini, claude-3-haiku-20240307)

# iFinD (Tonghuashun) Credentials
# Optional - system will fallback to public APIs if not configured
IFIND_USERNAME=
IFIND_PASSWORD=

# Server Configuration
HOST=0.0.0.0
PORT=8100
DEBUG=false
